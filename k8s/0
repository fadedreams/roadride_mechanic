helm repo add bitnami https://charts.bitnami.com/bitnami
helm repo update
helm install mongodb bitnami/mongodb -f mongodb-values.yaml

# Get the root password you set (password in your values.yaml)
MONGODB_ROOT_PASSWORD=$(kubectl get secret mongodb -o jsonpath='{.data.mongodb-root-password}' | base64 -d)

# Connect interactively
kubectl exec -it mongodb-0 -- mongosh "mongodb://root:${MONGODB_ROOT_PASSWORD}@localhost:27017/admin"

mongodb-values.yaml
architecture: replicaset  # Top-level for replicaset
auth:
  enabled: true
  rootPassword: password  # Root user: root / password
replica:
  replicaCount: 1  # Single member (primary only)
  replicaSetName: rs0
  arbiter:
    enabled: false  # Disable arbiter (unneeded for 1-member; avoids resources warning)
persistence:
  enabled: true
  size: 1Gi
  storageClass: standard
resources:
  requests:
    cpu: 250m
    memory: 512Mi
  limits:
    cpu: 500m
    memory: 1Gi

# Port-forward
kubectl port-forward svc/mongodb 27017:27017 &
# Connect from your laptop
mongosh "mongodb://root:password@localhost:27017/admin"

